{
  "name": "jsjewelry-designer",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "routes": [
    { "pattern": "design.jsjewelry.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker.js"
}
